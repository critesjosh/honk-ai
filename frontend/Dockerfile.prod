# Production frontend: Vite build → nginx static serve.
# Vite bakes env vars at build time, so VITE_* values are passed via ARG.
# Intended to run behind a reverse proxy (Caddy/nginx) that terminates
# TLS and gates auth — this container only serves the built SPA.

FROM node:22-bullseye-slim AS build
ARG VITE_API_HOST=""
ARG VITE_API_STREAMING="true"
# Aztec fork: when "true", the agent create/edit form is replaced with a
# notice instructing admins to manage agents directly in the backend.
ARG VITE_DISABLE_AGENT_EDIT="false"
ENV VITE_API_HOST=$VITE_API_HOST
ENV VITE_API_STREAMING=$VITE_API_STREAMING
ENV VITE_DISABLE_AGENT_EDIT=$VITE_DISABLE_AGENT_EDIT

WORKDIR /app
COPY package*.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
