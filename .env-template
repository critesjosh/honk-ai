API_KEY=<LLM api key for LLM_PROVIDER (default openrouter, so an OpenRouter key)>
LLM_NAME=qwen/qwen3.6-flash
VITE_API_STREAMING=true
INTERNAL_KEY=<internal key for worker-to-backend authentication>

# MCP Key Provisioning (for Discord /mcp-key command)
# MCP_PROVISIONING_KEY=<dedicated key for the /mcp-key Discord command — separate from INTERNAL_KEY>
# AZTEC_SOURCE_IDS=<comma-separated Postgres source UUIDs for Aztec MCP agents>
#
# Public web /ask bundle: bearer key for the static-page agent. BAKED
# INTO THE PUBLIC JS at build time, so it's a known-public capability.
# The agent it points at is hard-capped on requests + tokens and has
# no tools — its only capability is asking the public RAG bot.
# Provision (or refresh) the agent first, then capture the printed key.
# The script is not in the backend image; bind-mount scripts/ and put
# /app on PYTHONPATH so the script can import application.core.settings.
#   docker compose --env-file .env -f deployment/docker-compose-hub.yaml run --rm \
#     -v "$(pwd)/scripts:/app/scripts:ro" \
#     -e PYTHONPATH=/app \
#     -e ASK_AZTEC_AGENT_KEY="$(openssl rand -hex 32)" \
#     -e ASK_AZTEC_PROMPT_ID="0780959b-3c18-4ad9-8284-691665233a6f" \
#     -e ASK_AZTEC_DEFAULT_MODEL_ID="qwen/qwen3.6-flash" \
#     backend python scripts/db/create_ask_aztec_public_agent.py
# Without ASK_AZTEC_DEFAULT_MODEL_ID on FIRST creation, the agent is
# created with NULL default_model_id and falls back to LLM_NAME (now
# qwen/qwen3.6-flash — see PR #118 for the eval comparison vs the
# prior glm-4.6 default). The provisioner UPDATE uses
# COALESCE(:model, default_model_id) so re-runs without an env var
# preserve the live value; setting ASK_AZTEC_DEFAULT_MODEL_ID
# explicitly is recommended so the agent's model doesn't drift if
# LLM_NAME ever changes.
# Re-runs are idempotent on (user_id='public-web', name='Ask Aztec — public web')
# and PRESERVE the existing key — rotation is a deliberate UPDATE.
# VITE_ASK_AZTEC_AGENT_KEY=<paste agent key here>
# The FIRST UUID becomes the agent's primary source (agents.source_id); the
# rest go into extra_source_ids in order. NOTE: retrieval is a GLOBAL rerank
# across ALL sources by cosine distance (ClassicRAG._get_data), so the order is
# the canonical display/swap order, NOT a search priority. The canonical order
# is the single source of truth in scripts/ingest/swap_sources.py
# (_CANONICAL_ORDER, derived from corpora.py). Two-version KB: this list now
# spans BOTH versions' source ids + the shared corpora; the per-request
# retrieval narrowing (application/retriever/version_scope.py) selects the
# active version's subset. NOTE: this list seeds agents at CREATION only — to
# add a corpus to agents that already exist, run
# scripts/db/attach_source_to_agents.py.
#
# Network-status agent tools (Aztec L2 + Ethereum L1). Both have safe
# defaults and don't need to be set in dev; override only to point at a
# different chain / provider.
#
# Aztec L2 via Aztecscan REST. The tool's `network` arg picks the host:
# mainnet (default, api.aztecscan.xyz, l1ChainId=1) or testnet
# (api.testnet.aztecscan.xyz, Sepolia l1ChainId=11155111). Key is
# interpolated as a URL path segment (NOT a header); the public
# placeholder 'temporary-api-key' works without signup.
# AZTECSCAN_MAINNET_BASE_URL=https://api.aztecscan.xyz/v1
# AZTECSCAN_TESTNET_BASE_URL=https://api.testnet.aztecscan.xyz/v1
# AZTECSCAN_API_KEY=temporary-api-key
#
# Ethereum L1 JSON-RPC. Sepolia is the L1 the Aztec testnet anchors to
# (l1ChainId=11155111). Defaults are publicnode.com (free, no key); for
# production traffic point these at your own Infura/Alchemy/etc.
# ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
# ETHEREUM_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
#
# Provision the two `user_tools` rows + attach to Discord/widget agents:
#   docker compose --env-file .env -f deployment/docker-compose-hub.yaml run --rm \
#     -v "$(pwd)/scripts:/app/scripts:ro" \
#     -e PYTHONPATH=/app \
#     backend python scripts/db/create_network_tools.py --attach-to-agents
# (--dry-run prints what would change without committing.)
#
# AZTEC_CORPUS_VERSION=v4.3.1+v5.0.0-rc.1
# Surfaced via GET /api/version. The MCP server reads this to detect a
# version mismatch between the user's local aztec-packages clone and the
# corpus this backend has indexed. Two-version KB → a combined label
# listing both ingested release tags (mainnet+testnet). Empty/unset →
# endpoint returns "unknown" and MCP clients skip the version gate.

# Literal-identifier guardrail: verify long 0x hex literals (contract
# addresses, tx/block hashes, public keys) in grounded answers against the
# retrieved docs / question / prior turns / live tool results.
#   off     — disabled (legacy behaviour)
#   audit   — detect + log/record metadata only; never alters bytes (default)
#   enforce — also correct single-nibble corruptions / scrub unverifiable ones
# Roll out as audit first to size the false-positive rate, then enforce.
# LITERAL_GUARD_MODE=audit

# Provider-specific API keys (optional - use these to enable multiple
# providers; only openai / azure_openai / openrouter are supported)
# OPENAI_API_KEY=<your-openai-api-key>
# OPEN_ROUTER_API_KEY=<your-openrouter-api-key>

# --- Per-agent reasoning override (experimental) ---
# OpenRouter reasoning is DISABLED by default for some models (qwen3.6-flash,
# grok-4.1-fast) in application/llm/open_router.py, because their default
# chain-of-thought wastes the stream. For the agent UUIDs listed here it is
# instead ENABLED with a token budget — useful to give one surface (e.g. the
# Slack chat agent) better tool-call routing without affecting the others
# that share the same model. Applies only to calls that OFFER TOOLS (the
# agentic tool-routing turns); no-tool utility calls under the same agent
# (query rephrase, history compression) keep the model default/disable.
# CSV of agent UUIDs; empty = no override.
#   REASONING_ENABLED_AGENT_IDS=f7ae0b19-5f65-452c-8ca9-24a73f471252
# REASONING_ENABLED_AGENT_IDS=
# Reasoning-token budget (max_tokens) when enabled above. Default 16000;
# clamped to a floor of 1.
# NOTE: the backend usage frame estimates generated_tokens with tiktoken over
# the streamed chunks, NOT OpenRouter's billed usage. Reasoning streamed as
# `delta.reasoning` does surface as thought chunks and gets (roughly)
# counted, but reasoning conveyed only via `reasoning_details` is missed, so
# the bot-side per-guild/-workspace spend cap can UNDER-count cost while
# this is on. Keep the budget modest and watch actual OpenRouter spend.
# REASONING_MAX_TOKENS=16000

# Remote Embeddings (OpenAI-compatible API). Local SentenceTransformer
# embeddings were removed from this fork — set EMBEDDINGS_BASE_URL (or use
# EMBEDDINGS_NAME=openai_text-embedding-ada-002 with an OpenAI key);
# anything else raises at first embedding call.
EMBEDDINGS_BASE_URL=
EMBEDDINGS_KEY=
# EMBEDDINGS_DIMENSION must match the chosen embedding model. pgvector bakes
# the dimension into the `documents` column at first CREATE TABLE, and silently
# wrong values cause every insert to fail with "expected N dimensions, not M".
#   EMBEDDINGS_NAME=huggingface_sentence-transformers/all-mpnet-base-v2  →  768  (default)
#   EMBEDDINGS_NAME=text-embedding-3-small                               →  1536
#   EMBEDDINGS_NAME=text-embedding-3-large                               →  3072
# EMBEDDINGS_DIMENSION=768

#For Azure (you can delete it if you don't use Azure)
OPENAI_API_BASE=
OPENAI_API_VERSION=
AZURE_DEPLOYMENT_NAME=
AZURE_EMBEDDINGS_DEPLOYMENT_NAME=

# User-data Postgres DB (Phase 0 of the MongoDB→Postgres migration).
# Standard Postgres URI — `postgres://` and `postgresql://` both work.
# Leave unset while the migration is still being rolled out; the app will
# fall back to MongoDB for user data until POSTGRES_URI is configured.
# POSTGRES_URI=postgresql://docsgpt:docsgpt@localhost:5432/docsgpt

# =============================================================================
# Production deployment settings — required when using docker-compose-hub.yaml
# =============================================================================
#
# Generate the secret values once and treat them as unrotatable (especially
# ENCRYPTION_SECRET_KEY — changing it invalidates all encrypted data).
#
#     openssl rand -hex 32   # use for each of the *_KEY vars below
#
# PUBLIC_HOSTNAME=docs.yourcompany.com
# POSTGRES_PASSWORD=<openssl rand -hex 32>
# JWT_SECRET_KEY=<openssl rand -hex 32>
# ENCRYPTION_SECRET_KEY=<openssl rand -hex 32>   # UNROTATABLE — set once
# INTERNAL_KEY=<openssl rand -hex 32>
# MCP_PROVISIONING_KEY=<openssl rand -hex 32>
# USER_ID_PEPPER=<openssl rand -hex 32>          # UNROTATABLE — set once.
#                                                # HMAC pepper for pseudonymizing
#                                                # stored Discord user IDs. Rotation
#                                                # orphans every existing pseudonym
#                                                # (users would have to re-provision).
# POSTGRES_URI=postgresql://docsgpt:${POSTGRES_PASSWORD}@postgres:5432/docsgpt
# PGVECTOR_CONNECTION_STRING=${POSTGRES_URI}
# VECTOR_STORE=pgvector
# AUTO_MIGRATE=false                             # production: explicit migrations
# AUTO_CREATE_DB=false                           # production: explicit DB creation
# VERSION_CHECK=false                            # disable outbound telemetry
# CORS_ALLOWED_ORIGINS=https://${PUBLIC_HOSTNAME}
# Comma-separated. Supports shell-style globs (*, ?) — e.g.
# `https://*.netlify.app` matches every Netlify preview URL.
# Used for widget embeds on external docs sites; CORS is browser-only
# enforcement, real auth is still the per-request `api_key`.
# CONNECTOR_REDIRECT_BASE_URI=https://${PUBLIC_HOSTNAME}/api/connectors/callback
# IMAGE_TAG=0.17.0-aztec.1                       # pinned image tag
#
# --- Cloudflare Tunnel ---
# Create a tunnel in the Cloudflare Zero Trust dashboard
# (Networks → Tunnels → Create), copy the connector token here.
# Public Hostname route: $PUBLIC_HOSTNAME → HTTP → caddy:80
# Bind the tunnel ingress to an Access application AUD for defense in depth.
# CLOUDFLARE_TUNNEL_TOKEN=<paste from CF Zero Trust dashboard>
#
# --- Discord bot (runs in the hub compose) ---
# DISCORD_TOKEN=<bot token from https://discord.com/developers>
# NOIR_GUILD_IDS=<comma-separated guild ids the /mcp-key command is restricted to>
# Convention: add an inline-comment label per guild id above the assignment
# so operators don't have to hit the Discord API to remember which is which.
# Example:
#   #   1399477876461404252 = Aztec Bot Testing (private dev server)
#   #   1113924620781883405 = Noir            (public community server)
#   NOIR_GUILD_IDS=1399477876461404252,1113924620781883405
# Legacy single-guild form (still supported, merged into the list above):
# NOIR_GUILD_ID=<guild id the /mcp-key command is restricted to>
#
# Thread-context awareness — when triggered (either @-mentioned, or
# inline-replying to a previous Honk AI message) inside an existing
# thread (forum post, or a thread on someone else's message) the bot
# reads up to LIMIT prior thread messages and prepends them as context
# to the question so it can answer follow-ups in other users' discussions.
# Set LIMIT=0 to disable (the bot reverts to "answer in thread without
# any prior context"). NOTE: enabling this forwards other Discord
# users' message bodies and display names to the configured LLM
# provider (OpenRouter / OpenAI) when someone @-mentions OR replies to
# the bot in the thread. Trigger surface: explicit @-mention, inline
# reply to a Honk AI message, or DM — no passive scraping.
# DISCORD_THREAD_CONTEXT_LIMIT=30
# DISCORD_THREAD_CONTEXT_MAX_CHARS=12000
#
# Per-guild circuit breaker for Discord shared-bucket 429s (error
# code 40062, header `X-RateLimit-Scope: shared`). When a shared
# rate-limit is observed in a guild, suppress the /stream call for
# COOLDOWN_SECONDS and reply to silenced @-mentions with a brief
# "rate-limited, try again in about N minute(s)" notice (deduped to
# one per channel per cooldown window). If the notice send itself
# 429s against the throttled bucket, falls back to a single ⏳
# reaction.
#
# Default 60s. Observed `retry_after` on these 429s is 2.5-3s and
# Discord's docs use 3s as the canonical example; 60s gives ~20x
# headroom while sitting above discord.py's 30s "safe bail" floor
# (`max_ratelimit_timeout`'s documented minimum). Going below 30s
# risks re-walking into a still-pinned bucket; >120s has no evidence
# of benefit for shared-scope message-send 429s. Minimum 10s.
# DISCORD_SHARED_429_COOLDOWN_SECONDS=60
#
# The bot also overrides discord.py's default `max_ratelimit_timeout`
# (None / unbounded) to 2.0 seconds at runtime. This causes any 429
# whose `retry_after > 2.0` to raise `discord.RateLimited` IMMEDIATELY
# instead of running the library's 5-retry loop — which is what
# triggered Discord's anti-abuse flag against the bot account during
# the 2026-05-08 Noir incident. Not a tunable env var; see comment
# in extensions/discord/bot.py near the `bot.http.max_ratelimit_timeout`
# assignment for the full rationale.

# Per-guild daily estimated-USD spend cap for Honk AI's @-mention path.
# Format: comma-separated `<guild_id>=<usd>` pairs. A guild id absent
# from the map is uncapped. A cap of `0` is accepted as a hard
# kill-switch (refuses every call in that guild). All Discord guilds
# share a single backend agent key, so the backend's per-agent
# `limited_token_mode` cap can't gate one guild without gating the
# others — this bot-side cap closes that gap. Soft brake, not a hard
# accounting boundary: tiktoken estimates may drift ~10–20% from
# OpenRouter's reported usage on non-OpenAI tokenizers, and a bot
# restart clears the in-memory bucket. See extensions/discord/bot.py
# ("Per-guild daily estimated-USD spend cap") for the full rationale.
# Example: $20/day cap on the Aztec Network guild and $5/day on the
# Noir community server, with the bot-testing guild left uncapped:
#   DISCORD_GUILD_DAILY_USD_CAPS=1144692727120937080=20,1113924620781883405=5
# DISCORD_GUILD_DAILY_USD_CAPS=
#
# USD-per-million-token ceilings used to convert tiktoken counts in
# the backend's `usage` SSE frame into estimated USD. Defaults sit
# slightly above qwen3.6-flash actuals ($0.19 / $1.13 per 1M as of
# 2026-05); over-counting trips the cap "early" rather than "late",
# the safe failure mode. Re-tune (e.g. via openrouter.ai/models)
# when the bot's resolved model changes — `Aztec 4.3.0` is pinned
# to qwen3.6-flash today (see CLAUDE.md).
# DISCORD_USD_PER_PROMPT_MTOK=0.20
# DISCORD_USD_PER_COMPLETION_MTOK=1.20
#
# Pre-call reserve: charged to the guild bucket before /stream is
# invoked, then reconciled to actual after the response. Sized as a
# conservative upper bound on a typical Honk AI reply (~$0.005 at
# qwen). Higher = better bound on concurrent overshoot, lower =
# less impact when a transient backend failure burns the reserve
# without a reconcile. Default 1¢ has been fine in practice.
# DISCORD_PRE_CALL_RESERVE_USD=0.01

# --- Slack bot (runs in the hub compose) ---
# Socket Mode: no public ingress, no signing secret. Create a Slack app
# (manifest in extensions/slack/README.md), enable Socket Mode, and copy:
# SLACK_BOT_TOKEN=xoxb-...   # Bot User OAuth Token (OAuth & Permissions)
# SLACK_APP_TOKEN=xapp-...   # App-Level Token with connections:write scope
#
# The Slack chat agent's key (surface='slack'), provisioned by
# scripts/db/create_slack_chat_agent.py. This is a DIFFERENT agent than
# the Discord bot's — keep per-surface analytics clean. The compose maps
# SLACK_API_KEY → the slack-bot service's API_KEY.
# SLACK_API_KEY=<uuid printed by create_slack_chat_agent.py>
#
# Workspace allowlist for the slash commands + triggers. Comma-separated
# Slack team ids (T0...). Empty = allow all workspaces the app is in.
# Convention: inline-comment a label per id, same as NOIR_GUILD_IDS.
# SLACK_TEAM_IDS=
#
# Thread-context awareness — when @-mentioned inside a thread the bot
# reads up to LIMIT prior thread messages (via conversations.replies) and
# prepends them as context. Set LIMIT=0 to disable. NOTE: enabling this
# forwards other Slack users' message bodies + display names to the LLM
# provider when someone @-mentions the bot in a thread. Trigger surface is
# @-mention and DM only — no passive scraping of channel messages.
# SLACK_THREAD_CONTEXT_LIMIT=30
# SLACK_THREAD_CONTEXT_MAX_CHARS=12000
#
# Per-workspace daily estimated-USD spend cap, same mechanism + rationale
# as DISCORD_GUILD_DAILY_USD_CAPS (every workspace shares one backend
# agent key). Format: comma-separated `<team_id>=<usd>`; absent = uncapped;
# `0` = hard kill-switch. Soft brake, not a hard accounting boundary.
# Example: $20/day on one workspace, $5/day on another:
#   SLACK_TEAM_DAILY_USD_CAPS=T0AAA...=20,T0BBB...=5
# SLACK_TEAM_DAILY_USD_CAPS=
# SLACK_USD_PER_PROMPT_MTOK=0.20
# SLACK_USD_PER_COMPLETION_MTOK=1.20
# SLACK_PRE_CALL_RESERVE_USD=0.01

# =============================================================================
# Honk-ai-host MCP server (deployment/docker-compose-hub.yaml service `mcp`)
# =============================================================================
# Read-only SQL / RAG / logs surface for remote claudebox sessions. Two
# operating modes, gated by `MCP_AUTH_REQUIRED` (set in the compose file's
# mcp.environment block, NOT pulled from this .env):
#
#   MCP_AUTH_REQUIRED=false  (current production default)
#     Network-trust mode. The mcp container is isolated on a dedicated
#     compose network (`mcp_internal`, shared only with postgres) and
#     publishes only `127.0.0.1:7092:7092`. No public Caddy /mcp route, no
#     Cloudflare Access application — claudebox sessions reach the server
#     via an SSH tunnel chain to the host's loopback :7092. Defense layers
#     are SSH-key possession on each hop and the docsgpt_mcp_ro role's
#     column-level Postgres grants. `mcp_audit.token_id` is null for
#     anonymous calls; the rest of the audit row is unchanged.
#
#   MCP_AUTH_REQUIRED=true
#     Bearer mode. Restore the Caddy `@mcp` block, add a Cloudflare Access
#     service-token application, and issue per-claudebox bearers (see the
#     issue-token snippet below). The claudebox side ALSO needs bearer-
#     injection — cloxy strips inbound Authorization headers in the
#     sidecar — so don't flip this alone, coordinate both sides.
#
# Design + threat model: application/mcp_server/README.md. Operator
# runbook: AZTEC_SETUP.md → "Honk-ai MCP server".
#
# MCP_DB_PASSWORD=<openssl rand -hex 32>
# Password for the docsgpt_mcp_ro Postgres role (created by alembic 0006).
# Required in BOTH modes — the role is the DB binding the mcp container
# uses regardless of whether bearer auth is enabled.
# After setting it, run once on the host:
#   docker compose -f deployment/docker-compose-hub.yaml exec postgres \
#     psql -U docsgpt -d docsgpt -c \
#     "ALTER ROLE docsgpt_mcp_ro WITH LOGIN PASSWORD '${MCP_DB_PASSWORD}';"
# Rotation = update .env, re-run the ALTER ROLE, restart the mcp service.
#
# Bearer-mode only: after bringing the mcp service up, issue at least one
# token. Skip in network-trust mode — anonymous calls work without an
# entry in mcp_tokens.
#   docker compose -f deployment/docker-compose-hub.yaml run --rm \
#     -v "$(pwd)/scripts:/app/scripts:ro" -e PYTHONPATH=/app \
#     backend python scripts/mcp/issue_token.py issue \
#         --label cb-claudebox-rw --scopes db:read,rag:read,logs:read
# Copy the printed token into the claudebox credentials store; it is shown
# once and only the SHA-256 hash is persisted server-side.

# Disable conversation compression while the Discord-reaction
# feedback feature is live. Compression appends an extra
# conversation_messages summary row to long conversations, which
# silently desyncs the Discord bot's local position counter
# (`answer_count`) from the DB and causes 👍/👎 feedback on
# post-compression turns to no-op. Default in
# application/core/settings.py is True; flip to false here until
# the bot reads positions back from the backend directly. See
# AZTEC_SETUP.md → "Reading user feedback".
# ENABLE_CONVERSATION_COMPRESSION=false
