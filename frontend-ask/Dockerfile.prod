# Public-facing /ask landing page. Vite build → nginx static serve.
# VITE_ASK_AZTEC_AGENT_KEY is baked at build time and is a known-public
# bearer (the agent it points at is hard-capped on requests + tokens
# and has no tools — see scripts/db/create_ask_aztec_public_agent.py).
# Runs behind Caddy `handle /ask/*`; same origin as /stream so no CORS.

FROM node:22-bullseye-slim AS build
ARG VITE_ASK_AZTEC_AGENT_KEY=""
ARG VITE_ASK_AZTEC_API_BASE=""
ENV VITE_ASK_AZTEC_AGENT_KEY=$VITE_ASK_AZTEC_AGENT_KEY
ENV VITE_ASK_AZTEC_API_BASE=$VITE_ASK_AZTEC_API_BASE

WORKDIR /app
COPY package*.json ./
RUN npm install --no-audit --no-fund
COPY . .
RUN npm run build

FROM nginx:alpine
# CSP `connect-src` whitelist. Default is same-origin only, which is
# correct for prod where the bundle is served at /ask on the apex
# host and calls /stream on the same origin. Override at build time
# for cross-origin dev smoke tests, e.g.:
#   --build-arg ASK_CONNECT_SRC="'self' http://localhost:7091"
ARG ASK_CONNECT_SRC="'self'"
COPY --from=build /app/dist /usr/share/nginx/html/ask
COPY nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i "s|__ASK_CONNECT_SRC__|${ASK_CONNECT_SRC}|g" /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
