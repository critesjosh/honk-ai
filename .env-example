BOT_TOKEN=""
BOT_ID=""

AZTEC_DOCS_VERSION="" // Optional: pin to specific version/tag, or leave empty for auto-tracking latest release
DOCS_TESTNET_TAG="v1.2.0" // Testnet tag used in markdown processing

AllowedChannelIds="1400267448304795729,874127079694823506" // The channel IDs honk will respond in seperated by commas
LoggingChannelId="1255281982888480848" // The channel ID for logging
AnalyticsChannelId="1403209923998908507" // The channel where analytics will respond
MessageHistoryPerThread="6" // The number of messages to keep in the thread conversation history
DiscordTrainingForums="1147212093616046081" // The forum IDs for training seperated by commas
RequestsPerMinute="3" // The number of requests per minute a user can make to the LLM
ADMIN_USERS="816058457219792966" // (optional) comma-separated Discord user IDs for enhanced MCP analytics

CHROMADB_URL_PATH="localhost"
CHROMADB_URL_PORT="8001"
CHROMADB_URL_SSL="false"
CHROMADB_KNOWLEDGEBASE_ID="knowledge-base-test-2"
CHROMADB_AUTH="admin:$$2y$$05$$KcpzhLxxTNskFo3rwWISROvFFQBwDaYwbo5u9aaeFTxJfa7humHyW"

AMOUNT_OF_DOCS="4" // The number of documents that will be used in context for the LLM

LLM_PROVIDER="openai" // The LLM provider to use (openai or anthropic)
OPENAI_MODEL="gpt-5" // The model to use for the LLM when openai is selected

OPEN_AI_API="" // Your OpenAI API key
EMBEDDING_MODEL="text-embedding-3-large" // The model to use for the embeddings

ANTHROPIC_API="" // Your Anthropic API key
ANTHROPIC_MODEL="claude-sonnet-4-20250514" // The model to use for the LLM when anthropic is selected
ANTHROPIC_THINKING="false" // Whether to use thinking for the LLM when anthropic is selected
MAX_RESPONSE_TOKENS="20000" // The maximum number of tokens to use for the response (Also consider reasoning tokens)

GITHUB_TOKEN="" // The GitHub token to use for GitHub training
LMDB_ROUTE="./db/" // The route to use for the LMDB database (persistant storage)
SNAPSHOT_ROUTE="./snapshots/" // The route to use for the snapshots (persistant storage)

TRAINING_LIMIT="50" // The number of threads to process on startup

# MCP Server Configuration
MCP_ENABLED="true"
MCP_PORT="3000"
// This is simply the public URL for the MCP server, it uses this to tell the user where to add the MCP server to their client.
// So if you are proxying through https://example.com/, you would set this to https://example.com
MCP_SERVER_URL="http://localhost:3000"
MCP_AUTH_REQUIRED="true" // Whether to require an authentication token to use the MCP server.
MCP_RATE_LIMIT_ENABLED="true"
MCP_RATE_LIMIT_PER_MINUTE="10"

# Cloudflare Tunnel (optional - for public MCP access)
CLOUDFLARED_CONFIG_PATH="/path/to/.cloudflared/config.yml"
CLOUDFLARED_CREDENTIALS_PATH="/path/to/.cloudflared/credentials.json"
